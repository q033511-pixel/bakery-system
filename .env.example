# ============================================================
# ملف البيئة — انسخه إلى .env ثم املأ القيم الحقيقية
# Copy to .env and fill with your real Supabase project values
#
# ⚠️ SECURITY (بند 66/131 من المواصفة):
#    ضع هنا فقط Publishable (anon) Key — وليس service_role أبداً.
#    Only put the Publishable (anon) key here — NEVER the service_role key.
# ============================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-publishable-key...

# Optional: base path for GitHub Pages project sites (default '/')
# Example: repo "bakery-system" => VITE_BASE_PATH=/bakery-system/
VITE_BASE_PATH=/
